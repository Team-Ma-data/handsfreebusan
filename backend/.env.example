# ── 이 파일을 .env 로 복사하고 키만 채우면 끝 ────────────────────────────
# cp .env.example .env

# Upstage Solar (필수)
UPSTAGE_API_KEY=your-upstage-api-key-here

# 아래는 전부 선택. 401/404가 나면 BASE_URL 을 https://api.upstage.ai/v1/solar 로 바꿔볼 것.
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
SOLAR_MODEL=solar-pro3
SOLAR_TEMPERATURE=0.2
MAX_TOOL_TURNS=4
REQUEST_TIMEOUT=45

# 서버
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
HISTORY_LIMIT=20

# 1로 두면 팀원 engine/ladder.py 가 있어도 스텁을 쓴다 (데모 리스크 헤지)
TIMECARRY_FORCE_STUB=0
